// Resources of BCD3000Setup.exe.
//
// The three payloads are embedded here, which is why this installer needs no
// packaging tool: the whole product is one self contained executable built by the
// same MSVC that builds the driver.
//
// The payload paths are relative to this file. build.bat checks that each of them
// exists before calling rc, because rc reports a missing payload as a generic
// "cannot open file" that reads like a broken toolchain rather than a driver that
// has not been built yet.

#include <winresrc.h>
#include "version.h"

#define RT_MANIFEST_TYPE     24
#define MANIFEST_RESOURCE_ID 1

MANIFEST_RESOURCE_ID RT_MANIFEST_TYPE "admin.manifest"

// The application icon. Id 1 so that this is the icon the shell shows for the
// file. Original artwork of this project: three channel faders on a rounded
// badge. No third party art is involved.
1 ICON "bcd3000.ico"

// The ASIO driver, built by native/bcdasio/build.bat dll
101 RCDATA "..\\native\\bcdasio\\BcdAsio.dll"

// The control and LED service, built by PyInstaller from poc/bridge_service.py
102 RCDATA "..\\poc\\dist\\BCD3000Bridge.exe"

// The uninstaller, built by the "uninstall" target of this folder's build.bat
103 RCDATA "BCD3000Uninstall.exe"

// The virtual MIDI port, built by native/bcdmidi/build.bat dll. It goes BESIDE
// the control service, because that is the process that loads it.
104 RCDATA "..\\native\\bcdmidi\\BcdMidi.dll"

// *** MICROSOFT'S RUNTIME, AND THE ONE PAYLOAD HERE THAT IS NOT THIS PROJECT'S
//     WORK. *** Windows MIDI Services, Copyright (c) Microsoft Corporation, from
// github.com/microsoft/MIDI, under the MIT licence.
//
// MIT REQUIRES ITS COPYRIGHT NOTICE AND PERMISSION NOTICE TO TRAVEL WITH THIS
// BINARY. They are reproduced in full in the repository's LICENSE, and printed by
// this program itself - see printThirdPartyNotice() in setup.cpp - so that an
// installer handed to somebody with no repository around it still carries them.
// installer/verify's "exe" mode asserts both the notice and this payload's size.
//
// ONE FILE, ONE ID, ONE REFERENCE, referenced where the build already puts it
// rather than copied into this folder - the same discipline as the two pictures
// below. It is taken from runtimes/win-x64/native/ of the NuGet package and is
// 2,892,288 bytes; the arm64 build of the same name is 6,111,744 and must not be
// shipped. That is not left to a comment: the harness compares the embedded size
// with 2,892,288 written as a literal.
105 RCDATA "..\\native\\bcdmidi\\wms\\Windows.Devices.Midi2.dll"

// The photograph of the device on the window's first page.
//
// ONE FILE, ONE ID, ONE REFERENCE - this line. The bytes of docs\BCD3000.PNG go
// in unchanged and gui.cpp decodes them with WIC, so replacing the picture is
// replacing that one file: there is no generated BMP to keep in step, and nothing
// in the build has to be installed to produce one. The file is NOT duplicated
// into this folder; it is referenced where it already lives.
//
// *** IT IS A MANUFACTURER PRODUCT PHOTOGRAPH AND IS NOT COVERED BY THIS
// PROJECT'S LICENCE. *** See installer\README.md.
110 RCDATA "..\\docs\\BCD3000.PNG"

// The screenshot of Zadig's window on the checks page.
//
// ONE FILE, ONE ID, ONE REFERENCE - this line, exactly like the photograph above,
// and referenced where it already lives instead of being copied into this folder.
//
// A DIFFERENT LICENCE SITUATION FROM THE PHOTOGRAPH. This is a screenshot of the
// owner's own machine, taken by the owner, showing the owner's own device. Zadig is
// GPLv3; that licence covers the program, not a picture of its window. See
// installer\README.md.
111 RCDATA "..\\docs\\Zadig.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BCD_VERSION_MAJOR,BCD_VERSION_MINOR,BCD_VERSION_PATCH,BCD_VERSION_BUILD
 PRODUCTVERSION BCD_VERSION_MAJOR,BCD_VERSION_MINOR,BCD_VERSION_PATCH,BCD_VERSION_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "BCD3000 open source driver project"
            VALUE "FileDescription",  "Behringer BCD3000 ASIO driver installer"
            VALUE "FileVersion",      BCD_VERSION_STR
            VALUE "InternalName",     "BCD3000Setup"
            VALUE "OriginalFilename", "BCD3000Setup.exe"
            VALUE "ProductName",      "Behringer BCD3000 ASIO driver"
            VALUE "ProductVersion",   BCD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
