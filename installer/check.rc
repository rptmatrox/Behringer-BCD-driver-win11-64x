// Resources of BCD3000Check.exe. asInvoker, because it only reads.

#include <winresrc.h>
#include "version.h"

#define RT_MANIFEST_TYPE     24
#define MANIFEST_RESOURCE_ID 1

MANIFEST_RESOURCE_ID RT_MANIFEST_TYPE "invoker.manifest"

// The same icon as the installer and the uninstaller. Original artwork of this
// project; id 1 so the shell uses it for the file. This program stays a console
// program - it is a diagnostic tool and its output is what support asks for - but
// it is still a file in a folder and it still needs to look like it belongs.
1 ICON "bcd3000.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BCD_VERSION_MAJOR,BCD_VERSION_MINOR,BCD_VERSION_PATCH,BCD_VERSION_BUILD
 PRODUCTVERSION BCD_VERSION_MAJOR,BCD_VERSION_MINOR,BCD_VERSION_PATCH,BCD_VERSION_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "BCD3000 open source driver project"
            VALUE "FileDescription",  "Behringer BCD3000 driver machine check (read only)"
            VALUE "FileVersion",      BCD_VERSION_STR
            VALUE "InternalName",     "BCD3000Check"
            VALUE "OriginalFilename", "BCD3000Check.exe"
            VALUE "ProductName",      "Behringer BCD3000 ASIO driver"
            VALUE "ProductVersion",   BCD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
